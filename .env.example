# ---------------------------------------------------------------------------
# Smallgate -- example environment
#
# This file contains NO real secrets. Copy it to .env and generate your own:
#   ./sg artisan key:generate
# Never commit a filled in .env.
# ---------------------------------------------------------------------------

APP_NAME=Smallgate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

# --- Trusted hosts and proxies ---------------------------------------------
# APP_URL is the canonical address: every generated link (password reset,
# invitation) is built from it, never from the incoming request's Host header.
# Set it to the real https URL in production.
#
# The host of APP_URL is trusted automatically. Add further names here, comma
# separated, if the portal is legitimately reachable under more than one.
# Requests with any other Host are rejected outside the local environment.
# Subdomains are not trusted -- preview subdomains are a separate service.
TRUSTED_HOSTS=

# Reverse proxies allowed to set X-Forwarded-*. Empty means the headers are
# ignored, which is safe but makes the application see http behind a TLS
# terminating proxy. Use addresses or CIDR ranges, e.g. 10.0.0.0/8. "*" trusts
# whatever sits in front of the app and is only acceptable when nothing else
# can reach it.
TRUSTED_PROXIES=

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------------
# Never log secrets, tokens or personal data. Keep the level at "info" or
# higher in production; "debug" can capture request payloads.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=smallgate
DB_USERNAME=smallgate
DB_PASSWORD=secret

# Port the development database is published on to the host.
DB_PORT_FORWARD=55432

# --- Sessions --------------------------------------------------------------
# Database driver so a session can be revoked server side on password change.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# MUST be true in production -- the session cookie is then only sent over TLS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
# "lax" keeps the login flow working while blocking cross-site POSTs.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Password hashing ------------------------------------------------------
# Argon2id per OWASP: 64 MiB memory, 4 iterations, 1 thread. Raise on stronger
# hardware; never lower in production.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# --- Mail (Mailpit in local development) -----------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="portal@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailpit web interface: http://localhost:8025
MAILPIT_UI_PORT=8025

# --- Smallgate -------------------------------------------------------------
# How long an invitation link stays valid.
INVITATION_TTL_HOURS=72

# Failed logins per email+IP before the account is throttled.
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60

# Days before entries of the admin activity log are deleted.
ACTIVITY_RETENTION_DAYS=90

# --- Previews --------------------------------------------------------------
# One wildcard DNS record (*.preview.example.com) points at the preview
# server; Smallgate never creates DNS records itself.
PREVIEW_BASE_DOMAIN=preview.example.com

# Only "null" exists in the MVP: it records intent and touches nothing on the
# server. See docs/adr/0001-preview-subdomain-architecture.md.
PREVIEW_PROVISIONER=null

# Comma separated preview types administrators may use: static_directory,
# upstream_url. Empty means both here, but "upstream_url" only under
# compose.prod.yaml -- static directories are not served in production yet.
PREVIEW_TARGET_TYPES=

# Comma separated absolute directories a static preview target may live under.
# This is the path traversal allowlist.
PREVIEW_ALLOWED_ROOTS=/var/www/html/storage/app/previews

# Comma separated hosts an upstream preview target may point at. This is the
# SSRF allowlist -- empty means no upstream target is accepted at all. Customers
# are sent to the full URL, path included, e.g. customer.example.com/joinery.
PREVIEW_ALLOWED_UPSTREAM_HOSTS=

# Thumbnails: one screenshot per published preview version, taken by the queue
# worker with Playwright + Chromium (scripts/preview-screenshot.mjs). The app
# image ships Alpine's Chromium at /usr/bin/chromium; leave the path empty to
# use a browser installed with `npx playwright install chromium` instead.
PREVIEW_THUMBNAILS_ENABLED=true
PREVIEW_THUMBNAIL_CHROMIUM=/usr/bin/chromium
PREVIEW_THUMBNAIL_NODE=node
# Chromium's process sandbox. Needs docker/seccomp/chromium.json (set on the
# worker service). Without a working sandbox no screenshot is taken.
PREVIEW_THUMBNAIL_SANDBOX=true
# Seconds until a preview counts as not loading.
PREVIEW_THUMBNAIL_TIMEOUT=45

# Dates in the customer portal use this zone.
DISPLAY_TIMEZONE=Europe/Berlin

# The customer's message archive offers a mail to this address.
# Falls back to LEGAL_EMAIL; with neither set, the button is hidden.
CONTACT_EMAIL=""

# --- Legal pages -----------------------------------------------------------
# Imprint and privacy policy are configured here so no personal data of the
# operator ends up in the repository.
LEGAL_COMPANY="Your Company"
LEGAL_ADDRESS=""
LEGAL_EMAIL=""
LEGAL_PHONE=""
LEGAL_REPRESENTED_BY=""
LEGAL_VAT_ID=""
LEGAL_REGISTER_ENTRY=""

# --- Local seed data -------------------------------------------------------
# Used by the development seeder only; it refuses to run in production.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_PASSWORD=passwort-nur-fuer-lokale-entwicklung

# --- Vite ------------------------------------------------------------------
APP_PORT=8080
VITE_PORT=5173

# --- Production stack (compose.prod.yaml) ----------------------------------
# Not used by the development stack. See README, "Running in production".
#
# The host nginx answers for -- the host of APP_URL. Every other Host header is
# dropped without a response.
PORTAL_HOST=
# Interface the web port is published on. Loopback: only the reverse proxy on
# this machine can reach it, and TRUSTED_PROXIES may then name DOCKER_SUBNET.
WEB_BIND=127.0.0.1
# Fixed range of the stack's internal network. Put the same value into
# TRUSTED_PROXIES.
DOCKER_SUBNET=172.30.80.0/24
