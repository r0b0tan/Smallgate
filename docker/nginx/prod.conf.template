# Production configuration. The nginx image renders this template at start and
# substitutes ${PORTAL_HOST} (from compose.prod.yaml); nginx's own $variables
# are left alone because they are not set in the environment.
#
# TLS is terminated by the reverse proxy in front of this container. That proxy
# must pass the original Host header and set X-Forwarded-Proto/-For.

# Invitation and password reset links carry their one-time token -- and the
# reset link the address -- in the URL, and so does the handoff onto a preview
# host (ADR 0003). The access log gets the path with the
# secret cut off. The referrer is left out entirely: Referrer-Policy
# "same-origin" sends the full reset URL along with every asset of that page.
#
# Not covered: nginx's error log, whose format is fixed. It quotes the request
# line only when php-fpm cannot be reached, i.e. while the app is down.
map $request_uri $smallgate_log_uri {
    ~^/einladung/                /einladung/[entfernt];
    ~^/passwort-zuruecksetzen/   /passwort-zuruecksetzen/[entfernt];
    ~^/__smallgate/zugang        /__smallgate/zugang?[entfernt];
    default                      $request_uri;
}

log_format smallgate '$remote_addr - $remote_user [$time_local] '
                     '"$request_method $smallgate_log_uri $server_protocol" '
                     '$status $body_bytes_sent "$http_user_agent" "$http_x_forwarded_for"';

# Anything that does not name the portal is dropped without an answer. This is
# the first of two host checks; TRUSTED_HOSTS in the application is the second.
server {
    listen 80 default_server;
    server_name _;
    access_log /var/log/nginx/access.log smallgate;
    return 444;
}

server {
    listen 80;
    server_name ${PORTAL_HOST};
    root /var/www/html/public;
    index index.php;

    charset utf-8;
    client_max_body_size 16M;
    server_tokens off;

    access_log /var/log/nginx/access.log smallgate;

    # The CSP is deliberately strict: Smallgate loads no third-party scripts,
    # fonts or analytics of any kind. HSTS only takes effect over https, which
    # is how browsers reach this server through the proxy.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Uploading a draft (ADR 0004) is the one request allowed to be large.
    # nginx reads the body in the block that hands it to PHP, so the route
    # needs a fastcgi block of its own: a try_files to /index.php would apply
    # the 16M of the PHP block again.
    location ~ "^/admin/projekte/[0-9a-z]{26}/vorschauen/[0-9a-z]{26}/hochladen$" {
        client_max_body_size 66M;

        fastcgi_pass app:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_hide_header X-Powered-By;
    }

    # Hashed file names: a new build has new names, so the old ones can be
    # cached for good. add_header here replaces the server level headers, so
    # the ones that matter for static files are repeated.
    location /build/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Only the front controller is ever executed.
    location ~ ^/index\.php(/|$) {
        fastcgi_split_path_info ^(/index\.php)(/.*)$;
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php$ {
        return 404;
    }

    # Never serve dotfiles (.env, .git, ...) even if they end up under public/.
    location ~ /\. {
        deny all;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;
}

# Preview hosts: exactly one label below PREVIEW_BASE_DOMAIN (ADR 0003). The
# application checks the visitor's session and serves every file of a draft
# itself, so every request goes to the front controller -- nothing from
# public/ is served here, and nothing but GET and HEAD gets through.
#
# The pattern only takes the label apart; the rest has to be the preview domain
# exactly, or the request is dropped like any unknown host. An empty
# PREVIEW_BASE_DOMAIN switches the preview hosts off. PORTAL_HOST is an exact
# name above and always wins over this pattern.
server {
    listen 80;
    server_name ~^[a-z0-9]+(?:-[a-z0-9]+)*\.(?<preview_domain>.+)$;

    if ($preview_domain != "${PREVIEW_BASE_DOMAIN}") {
        return 444;
    }

    root /var/www/html/public;

    charset utf-8;
    client_max_body_size 1k;
    server_tokens off;

    access_log /var/log/nginx/access.log smallgate;

    # The application sets the headers for the draft (nosniff,
    # Cross-Origin-Resource-Policy, frame-ancestors, noindex). The portal's
    # strict CSP must not apply here: a draft is a website of its own.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        rewrite ^ /index.php last;
    }

    # REQUEST_URI stays the one the browser sent, encoded and with its
    # trailing slash -- the application needs both.
    location = /index.php {
        internal;

        limit_except GET {
            deny all;
        }

        fastcgi_pass app:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_hide_header X-Powered-By;
    }
}
