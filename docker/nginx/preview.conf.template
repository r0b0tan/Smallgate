# Preview hosts for local development: *.preview.localhost over TLS, handed to
# the application exactly like in production (prod.conf.template). The
# application checks the session and serves the draft (ADR 0003); nothing is
# read from disk here.
#
# Rendered by the nginx image at start; ${PREVIEW_BASE_DOMAIN} comes from
# compose.yaml. TLS because the preview session cookie is __Host- and Secure.
#
# Started on demand only: `docker compose --profile preview up -d preview`.

# Unknown hosts get nothing.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/preview.crt;
    ssl_certificate_key /etc/nginx/certs/preview.key;

    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ~^[a-z0-9]+(?:-[a-z0-9]+)*\.(?<preview_domain>.+)$;

    if ($preview_domain != "${PREVIEW_BASE_DOMAIN}") {
        return 444;
    }

    ssl_certificate     /etc/nginx/certs/preview.crt;
    ssl_certificate_key /etc/nginx/certs/preview.key;

    root /var/www/html/public;
    charset utf-8;
    client_max_body_size 1k;

    location / {
        rewrite ^ /index.php last;
    }

    location = /index.php {
        internal;

        limit_except GET {
            deny all;
        }

        fastcgi_pass app:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_hide_header X-Powered-By;
    }
}
